#!/usr/bin/env bash
# Painel do OpenWorkflow sob demanda: liga o app `amigo-painel` (parado por padrão), abre o túnel
# SSH para 127.0.0.1:3999 na VPS e, ao sair (Ctrl+C, erro ou túnel caído), desliga o painel.
# PAINEL_SEM_NAVEGADOR=1 só imprime a URL. PAINEL_MANTER_LIGADO=1 não desliga ao sair.
set -euo pipefail

APP=amigo-painel
PORTA=3999
URL="http://localhost:$PORTA"
PID=""

encerrar() {
  if [ -n "$PID" ]; then
    kill "$PID" 2>/dev/null || true
    wait "$PID" 2>/dev/null || true
  fi
  echo
  if [ -n "${PAINEL_MANTER_LIGADO:-}" ]; then
    echo "túnel encerrado; $APP continua ligado"
  elif ssh vps-mercurio dokku ps:stop "$APP" >/dev/null 2>&1; then
    echo "túnel encerrado; $APP desligado"
  else
    echo "aviso: não consegui desligar; rode: ssh vps-mercurio dokku ps:stop $APP" >&2
  fi
}
trap encerrar EXIT
trap 'exit 0' INT TERM

echo "ligando $APP..."
ssh vps-mercurio dokku ps:start "$APP" >/dev/null

ssh -N -o ExitOnForwardFailure=yes -L "$PORTA:127.0.0.1:$PORTA" vps-mercurio &
PID=$!

# Espera o túnel e o painel responderem (até ~30 s: o container acabou de subir).
pronto=""
for _ in $(seq 1 150); do
  kill -0 "$PID" 2>/dev/null || { echo "o túnel não subiu" >&2; exit 1; }
  if curl -s -o /dev/null "$URL/"; then pronto=1; break; fi
  sleep 0.2
done
[ -n "$pronto" ] || { echo "o painel não respondeu em 30 s" >&2; exit 1; }

echo "painel: $URL (Ctrl+C encerra e desliga o painel)"
if [ -n "${PAINEL_SEM_NAVEGADOR:-}" ]; then
  :
elif command -v wslview >/dev/null; then
  wslview "$URL" >/dev/null 2>&1 || true
elif command -v xdg-open >/dev/null; then
  xdg-open "$URL" >/dev/null 2>&1 || true
fi
wait "$PID"
